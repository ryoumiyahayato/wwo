{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wwo.example.invalid/schema/1900/source-record-v2.json",
  "title": "WWO 1900 historical source record",
  "description": "A normalized provenance-carrying staging record. Staging records are never runtime authority by themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "entity_type",
    "canonical_entity_id",
    "historical_entity_id",
    "historical_name",
    "normalized_name",
    "date_from",
    "date_to",
    "fact_type",
    "value",
    "unit",
    "source_id",
    "source_title",
    "source_author_or_institution",
    "source_locator",
    "source_reference",
    "source_date",
    "source_type",
    "confidence",
    "ambiguity_notes",
    "conflict_group",
    "review_status"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^1900-[a-z0-9][a-z0-9._-]*$"},
    "entity_type": {"type": "string", "enum": ["political_entity", "political_unit", "region", "city", "port", "rail_connection", "maritime_connection", "organization", "institution", "character", "infrastructure"]},
    "canonical_entity_id": {"type": ["string", "null"]},
    "historical_entity_id": {"type": "string", "minLength": 1},
    "historical_name": {"type": "string", "minLength": 1},
    "normalized_name": {"type": "string", "minLength": 1},
    "date_from": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "date_to": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "fact_type": {"type": "string", "enum": ["entity_exists", "capital", "sovereignty_relationship"]},
    "value": {"type": ["string", "number", "boolean", "object", "array"]},
    "unit": {"type": ["string", "null"], "enum": [null, "named_place", "relationship"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_title": {"type": "string", "minLength": 1},
    "source_author_or_institution": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string", "minLength": 1},
    "source_reference": {"type": "string", "minLength": 1, "pattern": "^[^#\\s]+#[^\\s]+$"},
    "source_date": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}-[0-9]{2})?$"},
    "source_type": {"type": "string", "enum": ["historical_gis", "official_report", "census", "yearbook", "scholarly_dataset", "scholarly_publication", "repository_derived", "archive", "reference_work"]},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "ambiguity_notes": {"type": "string", "minLength": 1},
    "conflict_group": {"type": ["string", "null"]},
    "review_status": {"type": "string", "enum": ["STAGED_NOT_RUNTIME", "CANDIDATE_REVIEW", "CONFLICT_REVIEW_REQUIRED", "REJECTED"]}
  }
}
