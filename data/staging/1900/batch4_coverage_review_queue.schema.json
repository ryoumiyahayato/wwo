{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wwo_1900_batch4_coverage_review_queue_v1",
  "title": "WWO 1900 Batch 4 coverage review queue",
  "description": "Mechanically copied admin1 and economy coverage gaps requiring historical evidence. Queue entries are not historical facts and carry no gameplay values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "batch", "snapshot_date", "policy", "summary", "admin1_queue", "economy_queue"],
  "properties": {
    "schema_id": {"const": "wwo_1900_batch4_coverage_review_queue_v1"},
    "batch": {"const": 4},
    "snapshot_date": {"const": "1900-03-12"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historical_fact", "runtime_authority", "numeric_values", "source_requirement", "no_inference"],
      "properties": {
        "historical_fact": {"const": false},
        "runtime_authority": {"const": false},
        "numeric_values": {"const": "none_added"},
        "source_requirement": {"const": "Each queue item requires a dated source locator and explicit historical crosswalk before promotion."},
        "no_inference": {"const": true}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admin1_items", "economy_items", "total_items", "admin1_unit_names", "economy_dimensions", "source_file_counts"],
      "properties": {
        "admin1_items": {"const": 15},
        "economy_items": {"const": 161},
        "total_items": {"const": 176},
        "admin1_unit_names": {"const": 327},
        "economy_dimensions": {"const": 11},
        "source_file_counts": {"type": "object", "additionalProperties": {"type": "integer"}}
      }
    },
    "admin1_queue": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/admin1"}},
    "economy_queue": {"type": "array", "minItems": 161, "maxItems": 161, "items": {"$ref": "#/$defs/economy"}}
  },
  "$defs": {
    "admin1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id", "queue_type", "source_path", "source_record_id", "source_index", "source_sha256", "candidate_status", "historical_fact", "runtime_authority", "required_evidence", "source_record", "notes"],
      "properties": {
        "queue_id": {"type": "string", "pattern": "^admin1:.+"},
        "queue_type": {"const": "admin1_coverage_review"},
        "source_path": {"const": "data/world_map/historical/historical_admin1_1900.json"},
        "source_record_id": {"type": "string", "minLength": 1},
        "source_index": {"type": "integer", "minimum": 0},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_status": {"const": "REVIEW_REQUIRED"},
        "historical_fact": {"const": false},
        "runtime_authority": {"const": false},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_record": {"type": "object"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id", "queue_type", "source_path", "source_record_id", "source_index", "source_sha256", "entity_id", "dimension", "source_status", "candidate_status", "historical_fact", "runtime_authority", "required_evidence", "source_record", "notes"],
      "properties": {
        "queue_id": {"type": "string", "pattern": "^economy:.+:"},
        "queue_type": {"const": "economy_dimension_review"},
        "source_path": {"const": "data/alpha/historical_economy_coverage_1900.json"},
        "source_record_id": {"type": "string", "minLength": 1},
        "source_index": {"type": "integer", "minimum": 0},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entity_id": {"type": "string", "minLength": 1},
        "dimension": {"type": "string", "minLength": 1},
        "source_status": {"enum": ["partial", "source_required"]},
        "candidate_status": {"const": "REVIEW_REQUIRED"},
        "historical_fact": {"const": false},
        "runtime_authority": {"const": false},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_record": {"type": "object"},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
