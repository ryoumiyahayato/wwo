{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "wwo_economic_geography_evidence_schema_r1_v2",
  "schema_version": 2,
  "title": "WWO 1900 economic geography assertion-scoped evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "target_year",
    "evidence_records"
  ],
  "properties": {
    "schema_id": {
      "const": "wwo_economic_geography_evidence_schema_r1_v2"
    },
    "schema_version": {
      "const": 2
    },
    "target_year": {
      "const": 1900
    },
    "evidence_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_record"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_:-]*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNASSESSED"
      ]
    },
    "evidence_level": {
      "enum": [
        "PRESENT",
        "MATERIAL",
        "MAJOR",
        "DOMINANT",
        "UNKNOWN"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "spatial_membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spatial_region_id",
        "coverage_bp",
        "relevance_bp",
        "role",
        "valid_from",
        "valid_to",
        "source_ids",
        "allocation_basis",
        "is_historical_measurement",
        "notes"
      ],
      "properties": {
        "spatial_region_id": {
          "$ref": "#/$defs/id"
        },
        "coverage_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "relevance_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "$ref": "#/$defs/date"
        },
        "valid_to": {
          "$ref": "#/$defs/date"
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        },
        "allocation_basis": {
          "enum": [
            "EVIDENCE_DERIVED",
            "CROSSWALK_ESTIMATE",
            "UNRESOLVED"
          ]
        },
        "is_historical_measurement": {
          "const": false
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "economic_region_id",
        "claim_kind",
        "subject_kind",
        "subject_id",
        "claim_level",
        "spatial_memberships",
        "temporal_basis",
        "observation_from",
        "observation_to",
        "observation_period_note",
        "simulation_applicability",
        "source_ids",
        "confidence",
        "notes"
      ],
      "properties": {
        "assertion_id": {
          "$ref": "#/$defs/id"
        },
        "economic_region_id": {
          "$ref": "#/$defs/id"
        },
        "claim_kind": {
          "enum": [
            "RESOURCE_ENDOWMENT",
            "AGRICULTURAL_PROFILE",
            "EXTRACTION_PROFILE",
            "INDUSTRIAL_PROFILE",
            "INFRASTRUCTURE",
            "POPULATION_LABOR"
          ]
        },
        "subject_kind": {
          "enum": [
            "COMMODITY",
            "SECTOR",
            "INFRASTRUCTURE",
            "POPULATION_LABOR"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "string",
          "minLength": 1
        },
        "claim_level": {
          "$ref": "#/$defs/evidence_level"
        },
        "sector_id": {
          "$ref": "#/$defs/id"
        },
        "output_commodity_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "infrastructure_type": {
          "type": "string",
          "minLength": 1
        },
        "population_labor_type": {
          "type": "string",
          "minLength": 1
        },
        "spatial_memberships": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/spatial_membership"
          }
        },
        "temporal_basis": {
          "enum": [
            "DIRECT_1900",
            "NEAR_1900",
            "RETROSPECTIVE_BUT_APPLICABLE",
            "TEMPORALLY_WEAK"
          ]
        },
        "observation_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_period_note": {
          "type": "string",
          "minLength": 1
        },
        "simulation_applicability": {
          "enum": [
            "DIRECT_1900_STRUCTURAL_ONLY",
            "NEAR_1900_STRUCTURAL_ONLY",
            "RETROSPECTIVE_1900_STRUCTURAL_ONLY",
            "NOT_FOR_QUANTITATIVE_CALIBRATION"
          ]
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "quantitative_evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economic_region_id",
        "display_name",
        "region_kind",
        "valid_from",
        "valid_to",
        "confidence",
        "source_ids",
        "assertions",
        "notes"
      ],
      "properties": {
        "economic_region_id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "region_kind": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "$ref": "#/$defs/date"
        },
        "valid_to": {
          "$ref": "#/$defs/date"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
